# =========================
# Meshy (server-only)
# =========================
MESHY_API_KEY=your_meshy_api_key_here
NEXT_PUBLIC_MOCK_AI=true
# true disables both preview submissions and checkout. Automated UI tests mock APIs.
# Global cost guard in addition to the 6/hour per-IP limit.
PREVIEW_GLOBAL_HOURLY_LIMIT=30
# Number of colors requested for the multi-color 3MF. 1-16; 8 is a good first test.
MESHY_PRINT_MAX_COLORS=8
# Your printer, exactly as Bambu Studio names it. Meshy's 3MF carries no printer
# info, so Bambu Studio discards its config and opens the model in one colour.
# With this set, the 3MF opens on this printer with all filament slots + colours.
BAMBU_PRINTER_MODEL=Bambu Lab A1
# Profile code inside system preset names (A1, A1M, P1P, P1S, X1C, X1E, H2D).
# Derived from BAMBU_PRINTER_MODEL when omitted.
BAMBU_PROFILE_CODE=A1
BAMBU_NOZZLE_DIAMETER=0.4
# Optional exact preset names, if the derived ones do not match your Bambu Studio:
# BAMBU_PRINTER_SETTINGS_ID=Bambu Lab A1 0.4 nozzle
# BAMBU_PRINT_SETTINGS_ID=0.20mm Standard @BBL A1
# BAMBU_FILAMENT_SETTINGS_ID=Bambu PLA Basic @BBL A1
# Public production base URL used to build Meshy webhook callbacks.
SITE_URL=https://your-production-domain.example
# Dedicated signing secret for private assets and expiring preview tokens.
ASSET_PROXY_SECRET=replace-with-a-dedicated-long-random-secret
# Dedicated long random secret for Meshy callbacks. If omitted, CRON_SECRET is used as fallback.
MESHY_WEBHOOK_SECRET=replace-with-a-long-random-secret

# =========================
# Existing POPME Shopify store only
# NEVER use credentials from another store here.
# =========================
SHOPIFY_STORE_DOMAIN=your-popme-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your_private_storefront_token
# Optional fallback:
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_token
# Easiest setup: the product handle. The backend resolves 10/15/20 cm variants itself.
SHOPIFY_PRODUCT_HANDLE=personalizirana-3d-figurka
# Server-owned prices. Must agree with the same Shopify variants or checkout stops.
TOY_PRICE_10CM_EUR=49
TOY_PRICE_15CM_EUR=69
TOY_PRICE_20CM_EUR=89
# Optional fallback if you prefer fixed GIDs:
# SHOPIFY_VARIANT_10CM=gid://shopify/ProductVariant/000000000001
# SHOPIFY_VARIANT_15CM=gid://shopify/ProductVariant/000000000002
# SHOPIFY_VARIANT_20CM=gid://shopify/ProductVariant/000000000003

# Dev Dashboard app credentials. The backend exchanges them for a short-lived
# Admin token and provisions paid/cancelled/refund webhooks idempotently.
SHOPIFY_APP_CLIENT_ID=your_dev_dashboard_client_id
SHOPIFY_APP_CLIENT_SECRET=your_dev_dashboard_client_secret
# Optional legacy fallback for older custom apps:
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_api_token
# Optional; defaults to SHOPIFY_STOREFRONT_API_VERSION.
# SHOPIFY_ADMIN_API_VERSION=2026-07

# If the webhook is created in Shopify Admin > Settings > Notifications > Webhooks,
# paste the signing secret shown in that Webhooks section here.
SHOPIFY_WEBHOOK_SECRET=your_store_webhook_signing_secret
# App-managed webhooks use SHOPIFY_APP_CLIENT_SECRET above.

# =========================
# Approved POPME Supabase project (isolated fixture/staging for tests)
# =========================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional; defaults to toy-assets.
SUPABASE_STORAGE_BUCKET=toy-assets

# =========================
# Internal production dashboard
# =========================
ADMIN_PASSWORD=use-a-long-unique-password
# Minimum 32 characters. Generate a random secret.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Fallback/internal sync authentication. Use another long random value.
CRON_SECRET=replace-with-another-long-random-secret

# =========================
# Operator alerts (Resend)
# =========================
RESEND_API_KEY=re_your_resend_api_key
ALERT_EMAIL_TO=you@example.com
# Must be a sender on a domain verified in Resend. Until then the default
# onboarding@resend.dev sender only delivers to the Resend account owner.
ALERT_EMAIL_FROM=POPME Alerts <alerts@your-domain.example>
# Minutes a project may sit in an automated stage before an alert (default 120).
WATCHDOG_STALE_MINUTES=120

# =========================
# Data retention (see /privacy)
# =========================
# Days before generated files are deleted for unpaid checkouts (default 7).
RETENTION_UNPAID_DAYS=7
# Days after an order is shipped or cancelled before files are deleted (default 90).
RETENTION_PAID_DAYS=90
